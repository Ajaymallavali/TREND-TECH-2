{
  "name": "trend-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TREND-TECH \u2014 a shopping intelligence and price-comparison platform (MERN)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npx concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/src/server.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "install:all": "npm install",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "seed:verified": "npm run seed:verified --workspace=server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "build": "npm run build --workspace=client",
    "deploy": "npm run build && wrangler deploy",
    "deploy:cloudflare": "npm run build && wrangler pages deploy ./client/dist --project-name=trend-tech",
    "deploy:vercel": "npx vercel --prod"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  }
}
