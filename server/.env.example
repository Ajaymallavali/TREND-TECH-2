# ---- Server ----
NODE_ENV=development
LOG_LEVEL=info
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/trend-tech

# ---- Redis / Queues ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_string

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TREND-TECH <no-reply@trend-tech.app>"

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
