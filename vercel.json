{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/product-images/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/catalogSnapshot.json",
      "destination": "/catalogSnapshot.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
