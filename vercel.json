{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/product-images/(.*)",
      "destination": "/api"
    },
    {
      "source": "/catalogSnapshot.json",
      "destination": "/catalogSnapshot.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
